DATABASE_URL=sqlite:///./data/job_agent.db
HOST=0.0.0.0
PORT=8000
WORKER_POLL_SECONDS=3
MAX_APPLICATIONS_PER_RUN=10
# Ollama on the host machine, used from Docker. Ollama must listen on all
# interfaces (OLLAMA_HOST=0.0.0.0). Without Docker use http://127.0.0.1:11434/v1/chat/completions
LLM_BASE_URL=http://host.docker.internal:11434/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
AUTO_SUBMIT=false
